# ─────────────────────────────────────────────────────────────────────────────
# Copiá este archivo como .env y completá los valores.
# .env está en .gitignore (nunca se sube a git). Este .env.example sí se sube.
#
# REGLA: las claves SECRETAS nunca llevan prefijo VITE_ (Vite embebe todo lo
#        VITE_ en el bundle del navegador → sería público).
# ─────────────────────────────────────────────────────────────────────────────

# ── Públicas (cliente) — visibles en el bundle por diseño ────────────────────
VITE_FIREBASE_API_KEY=tu-api-key-de-firebase
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# ── Secretas (solo servidor: netlify/functions/sugerencias.js) ───────────────
# Lista de keys de Groq separada por comas (se recortan espacios y vacías)
GROQ_API_KEYS=primera_key_de_groq,segunda_key_de_groq
# Modelos en orden de rotación (el servidor pasa al siguiente ante un fallo)
GROQ_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b,qwen/qwen3.8-27b,allam-2-7b
# Proyecto Firebase (issuer/audience del ID token verificado con jose)
FIREBASE_PROJECT_ID=tu-proyecto
# Orígenes permitidos por CORS (coma-separados). Ej: https://tu-app.netlify.app
ALLOWED_ORIGIN=https://tu-app.netlify.app
# (opcional) Mirrors de Open Food Facts en orden de fallback, para las funciones
# de alimentos (default: es,us,world — medido, es es el más estable)
OFF_MIRRORS=es,us,world
